# Environment Configuration Template
# Copy to .env for local environment overrides

# Gateway Settings
SERVER_PORT=8080
ML_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Settings (H2 default for instant local execution; switch to PostgreSQL for Docker)
DB_URL=jdbc:h2:file:./data/spring_energy_db;DB_CLOSE_ON_EXIT=FALSE;AUTO_RECONNECT=TRUE
DB_DRIVER=org.h2.Driver
DB_USER=sa
DB_PASSWORD=

# ML Service Settings
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
ACTIVE_DATASET=data/processed/dataset_augmented_5000.csv
